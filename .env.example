# Copy to .env for local development only. Never commit real credentials.
TELEGRAM_BOT_TOKEN=replace-with-your-telegram-bot-token
OWNER_NUMBER=replace-with-international-number
OWNER_TELEGRAM_ID=replace-with-telegram-user-id
# Admin access only; keep this secret in Railway Variables or a local ignored .env.
# Use a strong value of at least 12 characters.
ADMIN_PASSWORD=replace-with-a-strong-12-character-or-longer-secret
PORT=3000
